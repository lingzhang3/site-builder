# ---------------------------------------------------------------------------
# App metadata database (the platform's OWN Postgres — created by docker compose)
# This is NOT a customer database. Drizzle migrates only this one.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5433/site_builder

# ---------------------------------------------------------------------------
# Auth.js
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Encryption key for customer database credentials (AES-256-GCM).
# MUST be 32 bytes, base64-encoded. Losing it makes every stored connection
# unreadable; rotating it requires re-entering every connection's password.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
APP_ENCRYPTION_KEY=replace-me

# ---------------------------------------------------------------------------
# Query execution limits applied to every customer query.
# ---------------------------------------------------------------------------
QUERY_TIMEOUT_MS=15000
QUERY_ROW_LIMIT=5000

# Seconds a published dashboard's widget data is cached before re-querying the
# customer database. Keep this > 0 in production: a public link with no cache
# lets anyone with the URL hammer your customer's production database.
PUBLIC_CACHE_TTL_SECONDS=60

# Max queries per minute per published token.
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Set to "true" to allow connections to private/loopback addresses. Off by
# default because it lets a tenant point a connection at your own infra or at
# the cloud metadata endpoint (SSRF). Only enable for local development.
ALLOW_PRIVATE_DB_HOSTS=false

# ---------------------------------------------------------------------------
# Demo "customer" database, seeded by docker compose for local development.
# In the app UI, add a connection pointing at this to try things out:
#   host=localhost port=5434 db=demo_saas user=readonly password=readonly
# ---------------------------------------------------------------------------
DEMO_DATABASE_URL=postgres://readonly:readonly@localhost:5434/demo_saas
