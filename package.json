{
  "name": "site-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import ./scripts/resolve-paths.mjs --env-file-if-exists=.env src/db/seed.ts",
    "test": "node --import ./scripts/resolve-paths.mjs --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:watch": "node --import ./scripts/resolve-paths.mjs --test --watch \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@codemirror/lang-sql": "^6.8.0",
    "@uiw/react-codemirror": "^4.23.7",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.11.5",
    "next": "^15.3.0",
    "next-auth": "5.0.0-beta.25",
    "pg": "^8.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
